@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix earl: <http://www.w3.org/ns/earl#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix apos: <https://aiposture.org/ns#> .

# SHACL shapes for the AI Posture EARL v0 profile.
# These constrain a verified AI Posture assessment expressed in EARL 1.0 with
# AI-Posture-local (apos:) extension terms. The weakest-link coherence rule is
# expressed as a SPARQL constraint; the reference validator (scripts/validate.js)
# also enforces it directly.

apos:PostureReportShape
  a sh:NodeShape ;
  sh:targetClass apos:PostureReport ;
  sh:property [
    sh:path apos:specVersion ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:pattern "^v[0-9]+\\.[0-9]+(\\.[0-9]+)?$" ;
  ] ;
  sh:property [
    sh:path earl:subject ;
    sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
  ] ;
  sh:property [
    sh:path earl:assertedBy ;
    sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
  ] ;
  sh:property [
    sh:path dct:date ;
    sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime ;
  ] ;
  sh:property [
    sh:path apos:nextReview ;
    sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:date ;
  ] ;
  sh:property [
    sh:path apos:postureLevel ;
    sh:maxCount 1 ; sh:datatype xsd:integer ;
    sh:minInclusive 1 ; sh:maxInclusive 5 ;
  ] ;
  sh:property [
    sh:path apos:postureLevelName ;
    sh:maxCount 1 ; sh:datatype xsd:string ;
  ] ;
  sh:property [
    sh:path apos:constrainingVector ;
    sh:in ( "People" "Infrastructure" "Regulation" ) ;
  ] ;
  sh:property [
    sh:path apos:assertion ;
    sh:minCount 1 ;
    sh:node apos:AssertionShape ;
  ] ;
  # Group by report so multiple reports in one graph keep separate minima.
  # NOT EXISTS also rejects an omitted aggregate when assertions are in scope.
  sh:sparql [
    sh:message "postureLevel must equal the minimum apos:level over in-scope assertions (weakest-link rule)." ;
    sh:prefixes apos: ;
    sh:select """
      PREFIX apos: <https://aiposture.org/ns#>
      PREFIX earl: <http://www.w3.org/ns/earl#>
      SELECT $this WHERE {
        {
          SELECT $this (MIN(?lvl) AS ?computed) WHERE {
            $this apos:assertion ?a .
            ?a apos:inScope true .
            ?a earl:result ?r .
            ?r apos:level ?lvl .
          } GROUP BY $this
        }
        FILTER NOT EXISTS { $this apos:postureLevel ?computed . }
      }
    """ ;
  ] ;
  sh:sparql [
    sh:message "constrainingVector must name exactly the in-scope vectors at the aggregate minimum." ;
    sh:select """
      PREFIX apos: <https://aiposture.org/ns#>
      PREFIX earl: <http://www.w3.org/ns/earl#>
      SELECT DISTINCT $this WHERE {
        $this apos:postureLevel ?minimum .
        {
          $this apos:assertion ?a .
          ?a apos:inScope true ; apos:vector ?vector ; earl:result/apos:level ?minimum .
          FILTER NOT EXISTS { $this apos:constrainingVector ?vector . }
        } UNION {
          $this apos:constrainingVector ?vector .
          FILTER NOT EXISTS {
            $this apos:assertion ?a .
            ?a apos:inScope true ; apos:vector ?vector ; earl:result/apos:level ?minimum .
          }
        }
      }
    """ ;
  ] ;
  sh:sparql [
    sh:message "postureLevelName must match the aggregate level when present." ;
    sh:select """
      PREFIX apos: <https://aiposture.org/ns#>
      SELECT $this WHERE {
        $this apos:postureLevel ?level ; apos:postureLevelName ?name .
        BIND (IF(?level = 1, "Perceiving",
              IF(?level = 2, "Assessing",
              IF(?level = 3, "Integrating",
              IF(?level = 4, "Calibrating", "Engineering")))) AS ?expected)
        FILTER (?name != ?expected)
      }
    """ ;
  ] ;
  sh:sparql [
    sh:message "All-N/A reports must omit postureLevel and constrainingVector; postureLevelName must be absent or N/A." ;
    sh:select """
      PREFIX apos: <https://aiposture.org/ns#>
      SELECT DISTINCT $this WHERE {
        $this apos:assertion ?assertion .
        FILTER NOT EXISTS { $this apos:assertion/apos:inScope true . }
        { $this apos:postureLevel ?level . }
        UNION { $this apos:constrainingVector ?vector . }
        UNION {
          $this apos:postureLevelName ?name .
          FILTER (?name != "N/A")
        }
      }
    """ ;
  ] .

apos:AssertionShape
  a sh:NodeShape ;
  sh:targetClass earl:Assertion ;
  sh:property [
    sh:path earl:assertedBy ;
    sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
  ] ;
  sh:property [
    sh:path earl:subject ;
    sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
  ] ;
  sh:property [
    sh:path apos:vector ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:in ( "People" "Infrastructure" "Regulation" ) ;
  ] ;
  sh:property [
    sh:path apos:inScope ;
    sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ;
  ] ;
  sh:property [
    sh:path earl:test ;
    sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
  ] ;
  sh:property [
    sh:path earl:result ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:node apos:ResultShape ;
  ] ;
  sh:or (
    [ sh:property [ sh:path apos:inScope ; sh:hasValue true ] ;
      sh:property [ sh:path earl:result ; sh:node [
        sh:property [ sh:path apos:level ; sh:minCount 1 ] ;
        sh:property [ sh:path earl:outcome ; sh:not [ sh:in ( earl:inapplicable ) ] ]
      ] ] ]
    [ sh:property [ sh:path apos:inScope ; sh:hasValue false ] ;
      sh:property [ sh:path earl:result ; sh:node [
        sh:property [ sh:path earl:outcome ; sh:hasValue earl:inapplicable ] ;
        sh:property [ sh:path apos:level ; sh:maxCount 0 ]
      ] ] ]
  ) ;
  sh:sparql [
    sh:message "An in-scope test must match the published vector/level criterion IRI." ;
    sh:select """
      PREFIX apos: <https://aiposture.org/ns#>
      PREFIX earl: <http://www.w3.org/ns/earl#>
      SELECT $this WHERE {
        $this apos:inScope true ; apos:vector ?vector ; earl:test ?test ; earl:result ?result .
        ?result apos:level ?level .
        FILTER (STR(?test) != CONCAT("https://aiposture.org/criteria/v1/", LCASE(STR(?vector)), "/", STR(?level)))
      }
    """ ;
  ] .

apos:ResultShape
  a sh:NodeShape ;
  sh:property [
    sh:path earl:outcome ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:in ( earl:passed earl:failed earl:cantTell earl:inapplicable earl:untested ) ;
  ] ;
  sh:property [
    sh:path apos:level ;
    sh:maxCount 1 ; sh:datatype xsd:integer ;
    sh:minInclusive 1 ; sh:maxInclusive 5 ;
  ] ;
  sh:property [
    sh:path dct:date ;
    sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime ;
  ] ;
  # Evidence pointer: a passed assertion must resolve to an inspectable artifact.
  sh:property [
    sh:path dct:source ;
    sh:nodeKind sh:IRI ;
    sh:message "A passed AI Posture assertion must carry at least one dct:source evidence pointer." ;
  ] ;
  sh:or (
    [ sh:property [ sh:path earl:outcome ; sh:hasValue earl:passed ] ;
      sh:property [ sh:path dct:source ; sh:minCount 1 ] ]
    [ sh:property [ sh:path earl:outcome ; sh:not [ sh:in ( earl:passed ) ] ] ]
  ) .
